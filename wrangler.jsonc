{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catalog-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalog-data",
      "database_id": "1b533549-c008-4509-b923-be416adeb73d",
      "migrations_dir": "migrations",
    },
  ],
}
