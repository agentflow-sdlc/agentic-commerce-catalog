<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Catalog.Api</AssemblyName>
    <RootNamespace>Catalog.Api</RootNamespace>
    <Description>ASP.NET Core HTTP entry point and composition root for Catalog.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Accessors\Catalog.Accessors.csproj" />
    <ProjectReference Include="..\Catalog.Contracts\Catalog.Contracts.csproj" />
    <ProjectReference Include="..\Catalog.Managers\Catalog.Managers.csproj" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
